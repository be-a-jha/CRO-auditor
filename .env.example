# Required for the Claude audit, competitor discovery and all screenshot inputs (starts with sk-ant-api).
ANTHROPIC_API_KEY=

# Optional but recommended for batches: Google PageSpeed Insights API key (free in Google Cloud console).
PSI_API_KEY=

# Optional: models and effort. Defaults: audit on claude-sonnet-5-5, competitor discovery on claude-haiku-5-5, effort low.
# CRO_MODEL=claude-sonnet-5-5
# CRO_FAST_MODEL=claude-haiku-5-5
# CRO_EFFORT=low
