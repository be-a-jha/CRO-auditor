{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/worker.mjs": {
      "maxDuration": 240,
      "includeFiles": "{app.py,run.py,requirements.txt,cro/**,scripts/start-vercel-worker.sh}"
    }
  },
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/worker?route=config"
    },
    {
      "source": "/api/runs",
      "destination": "/api/worker?route=runs"
    },
    {
      "source": "/api/runs/:id",
      "destination": "/api/worker?route=run&id=:id"
    },
    {
      "source": "/out/ui-runs/:path*",
      "destination": "/api/worker?route=asset&file=:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
