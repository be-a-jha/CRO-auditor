<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>CRO Audit Batch</title>
<style>
:root{--ink:#16181d;--ink2:#4b5160;--ink3:#8a8f9c;--bg:#f5f5f2;--card:#fff;--line:#e6e5e0;--pass:#1a7f4b;--partial:#b7791f;--fail:#c0362c;--accent:#2f4bd8}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 -apple-system,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif}
.wrap{max-width:1240px;margin:0 auto;padding:28px 20px 60px}a{color:var(--accent)}
h1{font-size:26px;margin:4px 0 18px}.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3)}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px}@media(max-width:860px){.stats{grid-template-columns:1fr 1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}.k{font-size:12px;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em}
.big{font-size:30px;font-weight:700}.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;font-size:14px;min-width:980px}
th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top}th{font-size:12px;color:var(--ink3);text-transform:uppercase;letter-spacing:.05em;background:#fafaf8}
.bar{height:8px;background:#ecebe6;border-radius:99px;overflow:hidden;width:70px;display:inline-block;vertical-align:middle;margin-left:8px}.bar i{display:block;height:100%}
.chip{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;text-transform:uppercase}
.ok{background:#e5f3eb;color:var(--pass)}.err{background:#f8e3e1;color:var(--fail)}.warn{background:#fbf0dc;color:var(--partial)}
.sub{font-size:12.5px;color:var(--ink2)}.links a{margin-right:10px;white-space:nowrap}
</style></head>
<body><div class="wrap">
<div class="eyebrow">Product page CRO audit · batch</div><h1>{{ rows|length }} product pages</h1>
<div class="stats">
  <div class="card"><div class="k">Audited</div><div class="big">{{ ok|length }}/{{ rows|length }}</div><div class="sub">{% if seconds %}in {{ (seconds / 60)|round(1) }} min{% endif %}</div></div>
  <div class="card"><div class="k">Avg CRO score</div><div class="big">{{ avg_cro if avg_cro is not none else 'n/a' }}</div><div class="sub">{% if avg_comp is not none %}competitors avg {{ avg_comp }}{% endif %}</div></div>
  <div class="card"><div class="k">Avg mobile / desktop</div><div class="big">{{ avg_m if avg_m is not none else 'n/a' }} <span style="font-size:18px;color:var(--ink3)">/ {{ avg_d if avg_d is not none else 'n/a' }}</span></div></div>
  <div class="card"><div class="k">Critical issues</div><div class="big">{{ crit }}</div></div>
  <div class="card"><div class="k">Claude cost</div><div class="big">{{ '$%.2f'|format(totals.usd) if totals else '$0' }}</div><div class="sub">{% if totals and ok %}~${{ '%.3f'|format(totals.usd / ok|length) }} per page{% else %}rules only{% endif %}</div></div>
</div>
<div class="tw"><table><thead><tr><th>Page</th><th>CRO</th><th>Mobile</th><th>Desktop</th><th>Vs competitors</th><th>Perf</th><th>Biggest issue</th><th>Status</th></tr></thead><tbody>
{% for r in rows %}<tr>
<td><b>{% if r.report %}<a href="{{ r.report }}">{{ r.label }}</a>{% else %}{{ r.label }}{% endif %}</b><div class="sub">{{ r.input[:70] }}</div>{% if r.category %}<div class="sub">{{ r.category }}</div>{% endif %}
<div class="links sub">{% if r.optimized %}<a href="{{ r.optimized }}?highlight">optimised page</a><a href="{{ r.optimized }}?download" download="{{ r.slug }}-optimized.html">download HTML</a>{% endif %}</div></td>
<td>{% if r.cro_score is not none %}<b>{{ r.cro_score }}</b> {{ r.grade }}<span class="bar"><i style="width:{{ r.cro_score }}%;background:{{ col(r.cro_score) }}"></i></span>{% else %}n/a{% endif %}</td>
<td>{{ r.mobile_score if r.mobile_score is not none else 'n/a' }}</td>
<td>{{ r.desktop_score if r.desktop_score is not none else 'n/a' }}</td>
<td>{% if r.comp_avg is not none %}avg {{ r.comp_avg }} · rank {{ r.rank }}<div class="sub">{{ r.competitors|join(', ') }}</div>{% else %}<span class="sub">n/a</span>{% endif %}</td>
<td>{{ r.perf_score if r.perf_score is not none else 'n/a' }}<div class="sub">{{ r.perf_source }}</div></td>
<td class="sub">{{ r.top_issues[0] if r.top_issues else '' }}</td>
<td>{% if r.status == 'ok' %}<span class="chip ok">ok</span>{% elif r.status == 'partial' %}<span class="chip warn">partial</span>{% else %}<span class="chip err">{{ r.status }}</span>{% endif %}
{% if r.cost_usd %}<div class="sub">${{ '%.3f'|format(r.cost_usd) }}</div>{% endif %}
{% if r.error %}<div class="sub">{{ r.error[:160] }}</div>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
<p class="sub">Sorted worst CRO score first. summary.csv has the same data for outreach sheets.{% if totals %} Claude: {{ totals.calls }} calls, {{ '{:,}'.format(totals.input_tokens) }} input tokens ({{ '{:,}'.format(totals.cache_read_input_tokens) }} read from cache), {{ '{:,}'.format(totals.output_tokens) }} output tokens.{% endif %}</p>
</div></body></html>
